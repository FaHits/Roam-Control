    "A closed route needs at least 3 points.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A closed route needs at least 3 points."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闭合路线至少需要 3 个点位。"
          }
        }
      }
    },
    "A newer public release is available: %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A newer public release is available: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有更新的公开发布可用：%@。"
          }
        }
      }
    },
    "A random identifier is created for this installation and irreversibly hashed before it is sent. It is used only to estimate activity from participating installations.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A random identifier is created for this installation and irreversibly hashed before it is sent. It is used only to estimate activity from participating installations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统会为本次安装生成一个随机标识，并在发送前做不可逆哈希。它仅用于估算参与安装的活动规模。"
          }
        }
      }
    },
    "A real iPhone is required to start a location session.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A real iPhone is required to start a location session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动位置会话需要一台真实 iPhone。"
          }
        }
      }
    },
    "A route must have a non-zero length.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A route must have a non-zero length."

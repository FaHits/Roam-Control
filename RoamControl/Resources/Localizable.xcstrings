        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到达后沿原路反向走回起点。"
          }
        }
      }
    },
    "Allow Location access in Settings to show your real position.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Location access in Settings to show your real position."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许访问位置信息，以显示你的真实位置。"
          }
        }
      }
    },
    "An inactive session means Roam Control's worker has ended. Other apps may need time to acquire a fresh real location.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An inactive session means Roam Control's worker has ended. Other apps may need time to acquire a fresh real location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话处于未生效状态，说明 Roam Control 的工作进程已经结束。其他 App 可能需要一些时间才能获取新的真实位置。"
          }
        }
      }
    },
    "Anonymous Statistics": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymous Statistics"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名统计"
          }
        }
      }
    },
    "Another VPN may affect local device connections. If it is appropriate for your network, compare a test with that VPN paused. Keep LocalDevVPN enabled when starting a location session.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another VPN may affect local device connections. If it is appropriate for your network, compare a test with that VPN paused. Keep LocalDevVPN enabled when starting a location session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他 VPN 可能影响本地设备连接。如果适合你的网络环境，可以暂停该 VPN 后再对比测试结果。启动位置会话时请保持 LocalDevVPN 开启。"
          }
        }
      }
    },

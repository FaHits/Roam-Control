          }
        }
      }
    },
    "Roam Control has not detected another VPN. This is a troubleshooting check, not a diagnosis; an iOS scheduler rejection happens before the pairing connection starts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roam Control has not detected another VPN. This is a troubleshooting check, not a diagnosis; an iOS scheduler rejection happens before the pairing connection starts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Roam Control 未检测到其他 VPN。这只是排查用的检查，不是诊断结论；iOS 调度器拒绝发生在配对连接开始之前。"
          }
        }
      }
    },
    "Roam Control has not found LocalDevVPN's device connection yet.": {
